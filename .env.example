# PostgreSQL connection string.
#
# Copy this file to `.env.local` and fill in your own values:
#
#   cp .env.example .env.local
#
# On Vercel, set DATABASE_URL under Settings → Environment Variables
# (enable it for Production, Preview, and Development as needed).
#
# The database must be reachable from the deployed app, so a local PostgreSQL
# instance will not work for a hosted deployment — use a managed provider such
# as Neon, Supabase, Vercel Postgres, Railway, or Amazon RDS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
